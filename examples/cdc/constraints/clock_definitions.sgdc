##-- ==========================================================================
##-- SpyGlass Clock and Reset Definitions (SGDC)
##-- ==========================================================================
##-- This file defines the clock structure and reset signals for CDC analysis.
##-- SpyGlass needs this information to identify clock domain crossings.
##--
##-- IMPORTANT: Incomplete or incorrect clock definitions lead to:
##--   - False CDC violations (clocks incorrectly seen as asynchronous)
##--   - Missed real violations (asynchronous clocks treated as synchronous)
##-- ==========================================================================

##-- Set the top-level design
current_design async_fifo

##-- =========================================================================
##-- Clock Definitions
##-- =========================================================================

##-- Write clock — primary clock for write domain
create_clock -name wr_clk -period 10.0 [get_ports wr_clk]

##-- Read clock — primary clock for read domain
create_clock -name rd_clk -period 15.0 [get_ports rd_clk]

##-- =========================================================================
##-- Clock Relationships
##-- =========================================================================

##-- Write and read clocks are asynchronous (from independent sources)
set_clock_groups -asynchronous \
    -group {wr_clk} \
    -group {rd_clk}

##-- =========================================================================
##-- Reset Definitions
##-- =========================================================================

##-- Write domain reset (active low)
reset -name wr_rst_n -value 0 [get_ports wr_rst_n]

##-- Read domain reset (active low)
reset -name rd_rst_n -value 0 [get_ports rd_rst_n]
