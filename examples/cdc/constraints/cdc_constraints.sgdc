##-- ==========================================================================
##-- SpyGlass CDC Constraints (SGDC)
##-- ==========================================================================
##-- This file provides CDC-specific constraints that help SpyGlass
##-- understand the design's synchronization strategy.
##--
##-- Types of constraints:
##--   1. Clock definitions        — Identify clock domains
##--   2. Clock relationships      — Define sync/async relationships
##--   3. False paths              — Mark paths that don't need synchronization
##--   4. Gray code annotations    — Identify Gray-coded bus crossings
##--   5. Abstract specifications  — Describe custom synchronizer behavior
##-- ==========================================================================

##-- =========================================================================
##-- Example: Multi-clock SoC with multiple clock domains
##-- =========================================================================
##-- Uncomment and modify for your design

##-- current_design soc_top
##--
##-- # Primary clocks
##-- create_clock -name clk_cpu    -period 2.0  [get_ports clk_cpu]
##-- create_clock -name clk_bus    -period 5.0  [get_ports clk_bus]
##-- create_clock -name clk_pcie   -period 4.0  [get_ports clk_pcie]
##-- create_clock -name clk_usb    -period 20.0 [get_ports clk_usb]
##-- create_clock -name clk_uart   -period 100.0 [get_ports clk_uart]
##--
##-- # All clocks are asynchronous to each other
##-- set_clock_groups -asynchronous \
##--     -group {clk_cpu} \
##--     -group {clk_bus} \
##--     -group {clk_pcie} \
##--     -group {clk_usb} \
##--     -group {clk_uart}
##--
##-- # Generated clock (divider)
##-- create_generated_clock -name clk_cpu_div2 \
##--     -source [get_ports clk_cpu] \
##--     -divide_by 2 \
##--     [get_pins u_clk_div/clk_out]

##-- =========================================================================
##-- Async FIFO-specific constraints
##-- =========================================================================

current_design async_fifo

##-- Clock definitions (can also be in clock_definitions.sgdc)
create_clock -name wr_clk -period 10.0 [get_ports wr_clk]
create_clock -name rd_clk -period 15.0 [get_ports rd_clk]

set_clock_groups -asynchronous \
    -group {wr_clk} \
    -group {rd_clk}

##-- Resets
reset -name wr_rst_n -value 0 [get_ports wr_rst_n]
reset -name rd_rst_n -value 0 [get_ports rd_rst_n]

##-- =========================================================================
##-- Gray Code Annotations
##-- =========================================================================
##-- Tell SpyGlass that the FIFO pointers are Gray-coded, so multi-bit
##-- synchronization is safe.

##-- Write pointer (Gray-coded) synchronized to read domain
# cdc_gray_encoding \
#     -from [get_cells wr_ptr_gray*] \
#     -to   [get_cells wr_ptr_gray_rd_sync*]

##-- Read pointer (Gray-coded) synchronized to write domain
# cdc_gray_encoding \
#     -from [get_cells rd_ptr_gray*] \
#     -to   [get_cells rd_ptr_gray_wr_sync*]

##-- =========================================================================
##-- False CDC Paths
##-- =========================================================================
##-- Mark paths that don't need synchronization because the signals are
##-- quasi-static (change only during initialization or configuration).

##-- Example: Configuration registers written once at boot
# cdc_false_path \
#     -from [get_cells u_config/cfg_reg*] \
#     -to   [get_cells u_sync_config/sync*] \
#     -comment "Quasi-static configuration — set during init, stable in operation"

##-- =========================================================================
##-- Synchronizer Abstracts
##-- =========================================================================
##-- If using custom synchronizer cells (e.g., from a standard cell library),
##-- declare them so SpyGlass recognizes them.

##-- Example: Custom synchronizer cell
# abstract -cell SYNC2_CELL -type cdc
# abstract -cell SYNC3_CELL -type cdc

##-- =========================================================================
##-- FIFO Depth Constraint
##-- =========================================================================
##-- For FIFOs, SpyGlass can verify that the depth is sufficient for the
##-- clock frequency ratio.

# set_cdc_fifo_depth -from wr_clk -to rd_clk -depth 16
